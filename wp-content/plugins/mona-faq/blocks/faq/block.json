{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mona-faq/faq",
  "version": "0.1.0",
  "title": "FAQ",
  "category": "widgets",
  "icon": "editor-help",
  "description": "Affiche une liste de questions/réponses.",
  "attributes": {
    "selectedFaqs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "textdomain": "mona-faq",
  "editorScript": "file:./editor.js",
  "viewScript": "file:../../assets/faq.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
