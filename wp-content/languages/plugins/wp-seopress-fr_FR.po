#: src/Services/Sitemap/Diagnostic.php:841
msgid "Pretty permalinks are enabled."
msgstr "Les permaliens jolis sont activés."

#: src/Services/Sitemap/Diagnostic.php:881
msgid "images"
msgstr "images"

#: src/Services/Sitemap/Diagnostic.php:882
msgid "videos"
msgstr "vidéos"

#: src/Services/Sitemap/Diagnostic.php:1008
msgid "Conflicting SEO plugins"
msgstr "Extensions SEO conflictuelles"

#: src/Services/Sitemap/Diagnostic.php:1061
msgid "Caching plugins"
msgstr "Extensions de mise en cache"

#: src/Services/Sitemap/Diagnostic.php:1086
msgid "Server (NGINX)"
msgstr "Serveur (NGINX)"

#: src/Services/Sitemap/Diagnostic.php:1088
msgid "Your server runs NGINX. If sitemaps 404, the rewrite rules must be added to your server configuration. Your host can apply them."
msgstr "Votre serveur utilise NGINX. Si les plans de site renvoient une erreur 404, les règles de réécriture doivent être ajoutées à la configuration de votre serveur. Votre hébergeur peut les appliquer."

#. translators: %s: comma-separated list of plugin names.
#: src/Services/Sitemap/Diagnostic.php:1065
msgid "A caching or optimization plugin is active (%s). Exclude .xml and .xsl files from its cache and minification to avoid a blank or HTML sitemap."
msgstr "Une extension de mise en cache ou d’optimisation est active (%s). Excluez les fichiers .xml et .xsl de son cache et de sa minification pour éviter un plan de site vide ou en HTML."

#: src/Services/Sitemap/Diagnostic.php:859
msgid "Your site discourages search engines (Settings → Reading). Submitting a sitemap has little effect while this option is on."
msgstr "Votre site décourage les moteurs de recherche (Réglages → Lecture). Soumettre un plan de site a peu d’effet tant que cette option est activée."

#: src/Services/Sitemap/Diagnostic.php:876
msgid "Optional content types"
msgstr "Types de contenu facultatifs"

#: src/Services/Sitemap/Diagnostic.php:883
msgid "authors"
msgstr "auteurs/autrices"

#: src/Services/Sitemap/Diagnostic.php:898
msgid "Images, videos and authors are all included in the sitemap."
msgstr "Images, vidéos et auteurs/autrices sont tous inclus dans le plan de site."

#: src/Services/Sitemap/Diagnostic.php:960
msgid "Your robots.txt blocks the sitemap path with a Disallow rule. Remove it so search engines can fetch the sitemap."
msgstr "Votre fichier robots.txt bloque le chemin du plan de site avec une règle Disallow. Supprimez-la pour que les moteurs de recherche puissent récupérer le plan de site."

#: src/Services/Sitemap/Diagnostic.php:969
msgid "The sitemap is advertised in robots.txt."
msgstr "Le plan de site est annoncé dans robots.txt."

#: src/Services/Sitemap/Diagnostic.php:977
msgid "No Sitemap directive was found in robots.txt. Adding one helps search engines discover the sitemap faster."
msgstr "Aucune directive Plan de site n’a été trouvée dans robots.txt. En ajouter une aide les moteurs de recherche à découvrir le plan de site plus rapidement."

#. translators: %s: comma-separated list of plugin names.
#: src/Services/Sitemap/Diagnostic.php:1012
msgid "Another SEO plugin is active (%s). Running two sitemap generators at once can confuse search engines. Keep only one enabled."
msgstr "Une autre extension SEO est active (%s). Faire tourner deux générateurs de plan de site en même temps peut perturber les moteurs de recherche. Ne gardez qu’une seule activée."

#: src/Services/Sitemap/Diagnostic.php:1130
msgid "Unknown parser error."
msgstr "Erreur de parseur inconnue."

#: src/Services/Sitemap/Diagnostic.php:832
msgid "Plain permalinks are enabled. The pretty sitemap URL will not resolve. Set permalinks to \"Post name\" under Settings → Permalinks."
msgstr "Les permaliens simples sont activés. L’URL jolie du plan de site ne sera pas résolue. Configurez les permaliens sur « Nom de la publication » dans Réglages → Permaliens."

#. translators: %s: comma-separated list of disabled content types (e.g.
#. "videos, authors").
#: src/Services/Sitemap/Diagnostic.php:908
msgid "These optional content types are turned off: %s. This is fine if intended; if you expected them in your sitemap, enable them in the XML / HTML Sitemap settings above."
msgstr "Ces types de contenu facultatifs sont désactivés : %s. C’est correct si c’est intentionnel ; si vous les attendiez dans votre plan de site, activez-les dans les réglages Plan de site XML / HTML ci-dessus."

#: src/Services/Sitemap/Diagnostic.php:371
msgid "Content type"
msgstr "Type de contenu"

#. translators: %s: Content-Type header value.
#: src/Services/Sitemap/Diagnostic.php:381
msgid "Served as %s."
msgstr "Servi en tant que %s."

#: src/Services/Sitemap/Diagnostic.php:404
msgid "(none)"
msgstr "(aucun)"

#: src/Services/Sitemap/Diagnostic.php:419
msgid "Valid XML"
msgstr "XML valide"

#: src/Services/Sitemap/Diagnostic.php:432
msgid "A blank line or whitespace is printed before the XML declaration, which breaks the document. Remove any blank lines after a closing PHP tag in wp-config.php, functions.php or header.php."
msgstr "Une ligne vide ou un espace est imprimé avant la déclaration XML, ce qui casse le document. Supprimez toute ligne vide après une balise PHP fermante dans wp-config.php, functions.php ou header.php."

#: src/Services/Sitemap/Diagnostic.php:464
msgid "The document is well-formed XML."
msgstr "Le document est un XML bien formé."

#: src/Services/Sitemap/Diagnostic.php:581
msgid "Stylesheet (XSL)"
msgstr "Feuille de style (XSL)"

#: src/Services/Sitemap/Diagnostic.php:608
msgid "The XSL stylesheet loads correctly."
msgstr "La feuille de style XSL se charge correctement."

#. translators: %d: HTTP status code.
#: src/Services/Sitemap/Diagnostic.php:707
msgid "Returns HTTP %d."
msgstr "Retourne HTTP %d."

#: src/Services/Sitemap/Diagnostic.php:721
msgid "Served as HTML instead of XML (cache or CDN interference)."
msgstr "Servi en HTML au lieu de XML (interférence du cache ou CDN)."

#: src/Services/Sitemap/Diagnostic.php:733
msgid "Does not return valid XML."
msgstr "Ne retourne pas un XML valide."

#. translators: %s: number of URLs (formatted).
#: src/Services/Sitemap/Diagnostic.php:753
msgid "Valid, %s URL."
msgid_plural "Valid, %s URLs."
msgstr[0] "Valide, %s URL."
msgstr[1] "Valide, %s URLs."

#: src/Services/Sitemap/Diagnostic.php:825
msgid "Permalinks"
msgstr "Permaliens"

#. translators: %s: XML parser error message.
#: src/Services/Sitemap/Diagnostic.php:453
msgid "The document is not well-formed XML: %s"
msgstr "Le document n’est pas un XML bien formé : %s"

#. translators: %s: Content-Type header value.
#: src/Services/Sitemap/Diagnostic.php:403
msgid "Unexpected content type: %s. Search engines expect an XML media type."
msgstr "Type de contenu inattendu : %s. Les moteurs de recherche attendent un type média XML."

#: src/Services/Sitemap/Diagnostic.php:616
msgid "The XSL stylesheet does not load, so the sitemap looks blank in a browser. Search engines still read it, but exclude .xsl files from your cache to restore the preview."
msgstr "La feuille de style XSL ne se charge pas, donc le plan de site apparaît vide dans un navigateur. Les moteurs de recherche le lisent toujours, mais excluez les fichiers .xsl de votre cache pour restaurer l’aperçu."

#: src/Services/Sitemap/Diagnostic.php:543
msgid "This sitemap contains no URLs."
msgstr "Ce plan de site ne contient aucune URL."

#. translators: %d: number of child sitemaps.
#: src/Services/Sitemap/Diagnostic.php:530
msgid "The index references %d child sitemap."
msgid_plural "The index references %d child sitemaps."
msgstr[0] "L’index référence %d plan de site enfant."
msgstr[1] "L’index référence %d plans de site enfants."

#: src/Services/Sitemap/Diagnostic.php:520
msgid "The sitemap index is empty. It lists no child sitemaps, so search engines will find no URLs."
msgstr "L’index du plan de site est vide. Il ne liste aucun plan de site enfant, donc les moteurs de recherche ne trouveront aucune URL."

#: src/Services/Sitemap/Diagnostic.php:510
msgid "Sitemap contents"
msgstr "Contenu du plan de site"

#: src/Services/Sitemap/Diagnostic.php:318
msgid "The sitemap returns a 404 error. Flushing your permalinks usually fixes it; make sure pretty permalinks are enabled."
msgstr "Le plan de site renvoie une erreur 404. Vider vos permaliens la corrige généralement ; assurez-vous que les permaliens jolis sont activés."

#. translators: %d: HTTP status code.
#: src/Services/Sitemap/Diagnostic.php:331
msgid "The sitemap returns a server error (HTTP %d). Enable WP_DEBUG to inspect the PHP error behind it."
msgstr "Le plan de site renvoie une erreur serveur (HTTP %d). Activez WP_DEBUG pour inspecter l’erreur PHP associée."

#. translators: %d: HTTP status code.
#: src/Services/Sitemap/Diagnostic.php:345
msgid "The sitemap is protected (HTTP %d). Search engines will not be able to read it while access is restricted."
msgstr "Le plan de site est protégé (HTTP %d). Les moteurs de recherche ne pourront pas le lire tant que l’accès est restreint."

#. translators: %d: HTTP status code.
#: src/Services/Sitemap/Diagnostic.php:357
msgid "Unexpected HTTP status: %d."
msgstr "État HTTP inattendu : %d."

#: src/Services/Sitemap/Diagnostic.php:392
msgid "The sitemap is served as HTML instead of XML. A caching plugin, a CDN or a translation layer is most likely interfering. Exclude .xml and .xsl files from the cache."
msgstr "Le plan de site est servi en HTML au lieu de XML. Une extension de cache, un CDN ou une couche de traduction interfère très probablement. Excluez les fichiers .xml et .xsl du cache."

#: src/Services/Sitemap/Diagnostic.php:430
msgid "A byte-order mark (BOM) is output before the XML declaration. Re-save your wp-config.php, functions.php and header.php as UTF-8 without BOM."
msgstr "Un marqueur d’ordre d’octet (BOM) est émis avant la déclaration XML. Réenregistrez votre wp-config.php, functions.php et header.php en UTF-8 sans BOM."

#: src/Services/Sitemap/Diagnostic.php:434
msgid "Unexpected content is printed before the XML opening tag. A plugin or theme is echoing output too early. Check wp-config.php, functions.php and header.php."
msgstr "Un contenu inattendu est imprimé avant la balise ouvrante XML. Une extension ou un thème produit un output trop tôt. Vérifiez wp-config.php, functions.php et header.php."

#: src/Services/Sitemap/Diagnostic.php:476
msgid "Sitemap format"
msgstr "Format du plan de site"

#: src/Services/Sitemap/Diagnostic.php:485
msgid "Valid sitemap index (a list of child sitemaps)."
msgstr "Index du plan de site valide (une liste de plans de site enfants)."

#: src/Services/Sitemap/Diagnostic.php:486
msgid "Valid URL set sitemap."
msgstr "Plan de site URL valide."

#. translators: %s: the XML root element name found.
#: src/Services/Sitemap/Diagnostic.php:496
msgid "The root element is <%s>, not a sitemap. The expected root is <sitemapindex> or <urlset>."
msgstr "L’élément racine est <%s>, pas un plan de site. La racine attendue est <sitemapindex> ou <urlset>."

#. translators: %s: number of URLs (formatted).
#: src/Services/Sitemap/Diagnostic.php:554
msgid "This sitemap holds %s URLs, above the 50,000 limit per sitemap. Split it into several files."
msgstr "Ce plan de site contient %s URL, dépassant la limite de 50 000 par plan de site. Divisez-le en plusieurs fichiers."

#. translators: %s: number of URLs (formatted).
#: src/Services/Sitemap/Diagnostic.php:566
msgid "This sitemap lists %s URL."
msgid_plural "This sitemap lists %s URLs."
msgstr[0] "Ce plan de site liste %s URL."
msgstr[1] "Ce plan de site liste %s URLs."

#: src/Services/Sitemap/Diagnostic.php:663
msgid "Sub-sitemaps"
msgstr "Sous-plans de site"

#. translators: %d: number of sub-sitemaps left untested.
#: src/Services/Sitemap/Diagnostic.php:667
msgid "%d more sub-sitemap was not tested to keep the check fast."
msgid_plural "%d more sub-sitemaps were not tested to keep the check fast."
msgstr[0] "%d sous-plan de site supplémentaire n’a pas été testé pour accélérer la vérification."
msgstr[1] "%d sous-plans de site supplémentaires n’ont pas été testés pour accélérer la vérification."

#: src/Services/Sitemap/Diagnostic.php:710
msgid "Could not be reached."
msgstr "Impossible d’atteindre."

#: src/Services/Sitemap/Diagnostic.php:743
msgid "Does not look like a sitemap."
msgstr "Ne ressemble pas à un plan de site."

#. translators: %s: sub-sitemap group name (post type, taxonomy, author...).
#: src/Services/Sitemap/Diagnostic.php:688
msgid "Sub-sitemap: %s"
msgstr "Sous-plan de site : %s"

